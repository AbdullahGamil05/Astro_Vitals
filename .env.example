# Browser-visible: URL of YOUR backend analysis route (not the model provider).
# Leave empty to use the built-in deterministic demo engine.
VITE_AI_ANALYSIS_ENDPOINT=

# Backend only (used by server/ai-proxy.mjs). Never prefix these with VITE_.
AI_UPSTREAM_URL=
AI_API_KEY=

# Manus health assistant (server only; never prefix with VITE_).
MANUS_API_KEY=
# Secret used to sign session tokens (generate with: openssl rand -base64 32).
MANUS_SESSION_SECRET=
